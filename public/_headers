/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=86400

/slots/gates-of-1win/*
  Cache-Control: no-store
/slots/1win-bonanza/*
  Cache-Control: no-store
/en/slots/gates-of-1win/*
  Cache-Control: no-store
/en/slots/1win-bonanza/*
  Cache-Control: no-store

# The production artifact also has Pages aliases. Keep those mirrors noindex
# even when indexing is explicitly enabled for the custom domain.
https://slotfolio.pages.dev/*
  X-Robots-Tag: noindex
https://:deployment.slotfolio.pages.dev/*
  X-Robots-Tag: noindex
